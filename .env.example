# Copy to .env only if you need to change something.
# Docker Compose works without a .env file; every value below has a default.

# --- Docker Compose overrides ---
POSTGRES_USER=certificates
POSTGRES_PASSWORD=certificates
POSTGRES_DB=certificates
API_PORT=8000
LOG_LEVEL=INFO

# --- Running the app directly on your machine (outside Docker) ---
# Inside Docker, Compose sets these for each container and ignores the values here.
# Postgres and Redis are not published to the host by default; publish their
# ports in docker-compose.yml first if you run the app outside Docker.
# DATABASE_URL=postgresql+psycopg://certificates:certificates@localhost:5432/certificates
# CELERY_BROKER_URL=redis://localhost:6379/0
# CERTIFICATE_STORAGE_DIR=./data/certificates
